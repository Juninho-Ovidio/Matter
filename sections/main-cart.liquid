  #shopify-section-{{ section.id }} .mcart__rate:has(input:checked) { border-color: var(--color-text); box-shadow: inset 0 0 0 1px var(--color-text); }
  #shopify-section-{{ section.id }} .mcart__rate input {
    width: 18px;
    height: 18px;
    margin: 0;
    border: 1px solid var(--color-text);
