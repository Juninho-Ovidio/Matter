  }
  #shopify-section-{{ section.id }} .mcart__rate input:checked { background: radial-gradient(circle, var(--color-text) 45%, transparent 50%); }
  #shopify-section-{{ section.id }} .mcart__rate-name { font-size: 14px; }
  #shopify-section-{{ section.id }} .mcart__rate-days { display: block; font-size: 12px; opacity: 0.6; }
  #shopify-section-{{ section.id }} .mcart__rate-price { font-size: 14px; font-weight: 700; white-space: nowrap; }
  #shopify-section-{{ section.id }} .mcart__rates-note { margin: 10px 0 0; font-size: 12px; opacity: 0.6; }

  /* Observação */
  #shopify-section-{{ section.id }} .mcart__note { margin-top: 24px; border-top: 1px solid var(--color-border); }
  #shopify-section-{{ section.id }} .mcart__note summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    font-size: 14px;
    list-style: none;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .mcart__note summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .mcart__note[open] summary svg { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .mcart__note textarea {
    width: 100%;
    padding: 12px 14px;
    font-family: var(--font-body-family);
    font-size: 15px;
    color: var(--color-text);
    background-color: var(--color-background-contrast);
    border: 1px solid var(--color-border);
