  }
  #shopify-section-{{ section.id }} .mcart__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding-top: 22px;
    font-size: 13px;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    width: 100%;
  }
  #shopify-section-{{ section.id }} .mcart__back:hover { text-decoration: underline; }

  /* Resumo */
  #shopify-section-{{ section.id }} .mcart__summary {
    position: sticky;
    top: 24px;
    padding: clamp(22px, 2.4vw, 32px);
    background-color: var(--color-background-contrast);
    border: 1px solid var(--color-border);
  }
  #shopify-section-{{ section.id }} .mcart__summary-title {
    margin: 0 0 22px;
    font-family: var(--font-display-family);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.6vw, 1.6rem);
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .mcart__totals { display: grid; gap: 14px; margin: 0; padding-bottom: 20px; border-bottom: 1px solid var(--color-border); }
  #shopify-section-{{ section.id }} .mcart__totals div { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; }
  #shopify-section-{{ section.id }} .mcart__totals dt,
  #shopify-section-{{ section.id }} .mcart__totals dd { margin: 0; }
  #shopify-section-{{ section.id }} .mcart__totals dd { text-align: right; }
  #shopify-section-{{ section.id }} .mcart__totals-discount { color: var(--color-sale); }
  #shopify-section-{{ section.id }} .mcart__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 20px 0;
    font-size: 18px;
    font-weight: 700;
    border-bottom: 1px solid var(--color-border);
  }
  #shopify-section-{{ section.id }} .mcart__total strong { font-size: clamp(1.5rem, 2vw, 1.9rem); }

  #shopify-section-{{ section.id }} .mcart__coupon { padding: 20px 0 24px; }
  #shopify-section-{{ section.id }} .mcart__coupon-title { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 15px; }
  #shopify-section-{{ section.id }} .mcart__coupon-row { display: flex; gap: 10px; }
  #shopify-section-{{ section.id }} .mcart__coupon-row input {
    flex: 1;
    min-width: 0;
    min-height: 50px;
    padding: 0 14px;
    font-size: 15px;
    color: var(--color-text);
    background-color: var(--color-background-contrast);
    border: 1px solid var(--color-border);
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .mcart__coupon-row input::placeholder { text-transform: none; }
  #shopify-section-{{ section.id }} .mcart__coupon-row input:focus { outline: none; border-color: var(--color-text); }
  #shopify-section-{{ section.id }} .mcart__codes { margin: 10px 0 0; padding: 0; list-style: none; font-size: 13px; }
  #shopify-section-{{ section.id }} .mcart__codes .is-ok { color: var(--color-sale); }
  #shopify-section-{{ section.id }} .mcart__codes .is-bad { color: #b91c1c; }

  #shopify-section-{{ section.id }} .mcart__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-height: 60px;
    font-family: var(--font-body-family);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  #shopify-section-{{ section.id }} .mcart__checkout:hover { opacity: 0.9; transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .mcart__checkout:hover svg:last-child { transform: translateX(3px); }
  #shopify-section-{{ section.id }} .mcart__checkout svg { transition: transform 0.15s ease; }
  #shopify-section-{{ section.id }} .mcart__express { display: grid; gap: 8px; margin-top: 10px; }

  #shopify-section-{{ section.id }} .mcart__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .mcart__payment-icon { display: block; width: 52px; height: auto; }
  #shopify-section-{{ section.id }} .mcart__protected {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 0;
    font-size: 13px;
    opacity: 0.8;
  }

  /* Vazio */
  #shopify-section-{{ section.id }} .mcart__empty { max-width: 560px; padding: clamp(30px, 6vw, 80px) 0; }
  #shopify-section-{{ section.id }} .mcart__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    padding: 16px 28px;
    font-family: var(--font-heading-family);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    text-decoration: none;
    background-color: var(--color-accent);
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .mcart__layout { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .mcart__summary { position: static; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mcart__bar { flex-direction: column; align-items: flex-start; gap: 12px; }
    #shopify-section-{{ section.id }} .mcart__steps { gap: 8px; font-size: 12px; }
    #shopify-section-{{ section.id }} .mcart__steps li + li::before { width: 14px; }
    #shopify-section-{{ section.id }} .mcart__item-top { flex-direction: column; gap: 6px; }
    #shopify-section-{{ section.id }} .mcart__item-price { justify-items: start; }
    #shopify-section-{{ section.id }} .mcart__rate { grid-template-columns: auto 1fr auto; }
    #shopify-section-{{ section.id }} .mcart__rate-icon { display: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('main-cart-{{ section.id }}');
    if (!root || !root.querySelector('form')) return;

    function money(value) {
      var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'BRL';
      try {
        return new Intl.NumberFormat(document.documentElement.lang || 'pt-BR', { style: 'currency', currency: currency }).format(value);
      } catch (e) {
        return 'R$ ' + Number(value).toFixed(2).replace('.', ',');
      }
    }

    /* ---------- Quantidade ---------- */
    function changeLine(line, quantity) {
      root.classList.add('is-busy');
      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity })
      }).finally(function () { window.location.reload(); });
    }
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-qty]');
      if (!btn) return;
      var input = btn.parentElement.querySelector('input');
      var current = parseInt(input.value, 10) || 0;
      changeLine(Number(input.dataset.line), btn.dataset.qty === 'plus' ? current + 1 : Math.max(0, current - 1));
    });
    root.addEventListener('change', function (e) {
      var input = e.target.closest('.mcart__qty input');
      if (input) changeLine(Number(input.dataset.line), Math.max(0, parseInt(input.value, 10) || 0));
    });

    /* ---------- Cupom ---------- */
    var couponInput = root.querySelector('[data-coupon]');
    var couponBtn = root.querySelector('[data-coupon-apply]');
    function applyCoupon() {
      var code = couponInput.value.trim();
      if (!code) { couponInput.focus(); return; }
      couponBtn.setAttribute('aria-busy', 'true');
      window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent('{{ routes.cart_url }}');
    }
    if (couponBtn) couponBtn.addEventListener('click', applyCoupon);
    if (couponInput) couponInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); applyCoupon(); }
    });

    /* ---------- Frete por CEP ---------- */
    var cepInput = root.querySelector('[data-cep]');
    var cepBtn = root.querySelector('[data-cep-calc]');
    var placeEl = root.querySelector('[data-cep-place]');
    var errorEl = root.querySelector('[data-cep-error]');
    var ratesEl = root.querySelector('[data-rates]');
    var noteEl = root.querySelector('[data-rates-note]');
    var sumShipping = root.querySelector('[data-summary-shipping]');
    var sumTotal = root.querySelector('[data-summary-total]');
    var cartTotal = Number(sumTotal.dataset.cartTotal) / 100;
    var STORE_KEY = 'mater-cep';

    cepInput.addEventListener('input', function () {
      var d = cepInput.value.replace(/\D/g, '').slice(0, 8);
      cepInput.value = d.length > 5 ? d.slice(0, 5) + '-' + d.slice(5) : d;
    });
    cepInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); calc(); } });
    cepBtn.addEventListener('click', calc);

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = !msg;
    }

    function selectRate(price) {
      sumShipping.textContent = price === 0 ? 'Grátis' : money(price);
      sumTotal.textContent = money(cartTotal + price);
    }

    function renderRates(rates) {
      if (!rates.length) {
        showError('Não encontramos opções de entrega para esse CEP.');
        ratesEl.innerHTML = '';
        noteEl.hidden = true;
        return;
      }
      rates.sort(function (a, b) { return Number(a.price) - Number(b.price); });
      ratesEl.innerHTML = rates.map(function (r, i) {
        var days = '';
        if (r.delivery_days && r.delivery_days.length) {
          var d = r.delivery_days;
          days = d[0] === d[d.length - 1] ? d[0] + ' dias úteis' : 'De ' + d[0] + ' a ' + d[d.length - 1] + ' dias úteis';
        }
        var price = Number(r.price);
        var name = document.createElement('span');
        name.textContent = r.name;
        return '<label class="mcart__rate">' +
          // form="" aponta para um id inexistente: o radio não vai junto no POST do carrinho.
          '<input type="radio" name="mcart_rate" form="mcart-rates-only" value="' + price + '"' + (i === 0 ? ' checked' : '') + '>' +
          '<svg class="mcart__rate-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/></svg>' +
          '<span class="mcart__rate-name">' + name.innerHTML + (days ? '<span class="mcart__rate-days">' + days + '</span>' : '') + '</span>' +
          '<span class="mcart__rate-price">' + (price === 0 ? 'Grátis' : money(price)) + '</span>' +
          '</label>';
      }).join('');
      noteEl.hidden = false;
      selectRate(Number(rates[0].price));
      ratesEl.querySelectorAll('input').forEach(function (input) {
        input.addEventListener('change', function () { selectRate(Number(input.value)); });
      });
    }

    function poll(query, tries) {
      return fetch('/cart/async_shipping_rates.json?' + query, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.shipping_rates) return data.shipping_rates;
          if (tries <= 0) throw new Error('timeout');
          return new Promise(function (resolve) { setTimeout(resolve, 600); }).then(function () { return poll(query, tries - 1); });
        });
    }

    function calc() {
      var cep = cepInput.value.replace(/\D/g, '');
      showError('');
      if (cep.length !== 8) {
        showError('Digite um CEP válido com 8 números.');
        cepInput.focus();
        return;
      }
      cepBtn.setAttribute('aria-busy', 'true');
      try { localStorage.setItem(STORE_KEY, cep); } catch (e) {}

      fetch('https://viacep.com.br/ws/' + cep + '/json/')
        .then(function (r) { return r.json(); })
        .catch(function () { return {}; })
        .then(function (addr) {
          if (addr && addr.erro) throw new Error('cep');
          if (addr && addr.localidade) {
            placeEl.textContent = [addr.logradouro, addr.bairro, addr.localidade + ' - ' + addr.uf].filter(Boolean).join(', ');
            placeEl.hidden = false;
          }
          var query = 'shipping_address%5Bzip%5D=' + cep.slice(0, 5) + '-' + cep.slice(5) +
            '&shipping_address%5Bcountry%5D=Brazil' +
            (addr && addr.uf ? '&shipping_address%5Bprovince%5D=' + addr.uf : '');
          return fetch('/cart/prepare_shipping_rates.json?' + query, { method: 'POST', headers: { Accept: 'application/json' } })
            .then(function (r) {
              if (!r.ok) return r.json().then(function (j) { throw new Error(JSON.stringify(j)); });
              return poll(query, 10);
            });
        })
        .then(renderRates)
        .catch(function (err) {
          ratesEl.innerHTML = '';
          noteEl.hidden = true;
          showError(err && err.message === 'cep'
            ? 'CEP não encontrado. Confira os números.'
            : 'Não foi possível calcular agora. O frete aparece no próximo passo.');
        })
        .finally(function () { cepBtn.removeAttribute('aria-busy'); });
    }

    try {
      var saved = localStorage.getItem(STORE_KEY);
      if (saved) {
        cepInput.value = saved.slice(0, 5) + '-' + saved.slice(5);
        calc();
      }
    } catch (e) {}
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "default": true,
      "label": "t:sections.main_cart.settings.show_note.label"
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "R$",
      "default": 0,
      "label": "t:sections.main_cart.settings.free_shipping_threshold.label",
      "info": "t:sections.main_cart.settings.free_shipping_threshold.info"
    },
    {
      "type": "checkbox",
      "id": "show_express",
      "default": false,
      "label": "t:sections.main_cart.settings.show_express.label",
      "info": "t:sections.main_cart.settings.show_express.info"
    }
  ]
}
{% endschema %}
