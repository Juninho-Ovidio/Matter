{%- comment -%}
  ============================================================
  MAIN ACCOUNT PASSWORD — Nova senha / Ativar conta (Mater)
  ============================================================

  O QUE FAZ:
  Uma só section para as duas telas que chegam por link de e-mail,
  escolhida por template.name:
  - customers/reset_password   → cliente criou nova senha pelo
    "Esqueci minha senha".
  - customers/activate_account → cliente recebeu o convite da loja
    (conta criada pelo admin); pode ativar ou recusar.
  Campos: senha (com medidor de força) + confirmar senha.

  ONDE É USADA:
  templates/customers/reset_password.json e
  templates/customers/activate_account.json.
  Só aparece com as contas clássicas ativas (veja main-account-auth).
{%- endcomment -%}

{{ 'conta.css' | asset_url | stylesheet_tag }}
<script src="{{ 'conta.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign is_activate = false
  if template.name == 'activate_account'
    assign is_activate = true
  endif
-%}

<section class="conta">
  <div class="conta__grid">
    {% render 'conta-lateral',
      image: section.settings.image,
      eyebrow: section.settings.aside_eyebrow,
      title: section.settings.aside_heading,
      text: section.settings.aside_text,
      perks: section.settings.perks
    %}

    <div class="conta__card">
      <div class="conta__card-inner">
        {%- if is_activate -%}
          {%- form 'activate_customer_password', class: 'conta__form' -%}
            {% render 'conta-senha-form', form: form, is_activate: true %}
          {%- endform -%}
        {%- else -%}
          {%- form 'reset_customer_password', class: 'conta__form' -%}
            {% render 'conta-senha-form', form: form, is_activate: false %}
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_account_password.name",
  "tag": "section",
  "class": "section-main-account-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main_account_auth.settings.image.label",
      "info": "t:sections.main_account_auth.settings.image.info"
    },
    {
      "type": "text",
      "id": "aside_eyebrow",
      "default": "// Mater Catholic Store",
      "label": "t:sections.main_account_auth.settings.aside_eyebrow.label"
    },
    {
      "type": "textarea",
      "id": "aside_heading",
      "default": "Quase\nlá",
      "label": "t:sections.main_account_auth.settings.aside_heading.label"
    },
    {
      "type": "text",
      "id": "aside_text",
      "label": "t:sections.main_account_auth.settings.aside_text.label"
    },
    {
      "type": "text",
      "id": "perks",
      "default": "Acompanhe seus pedidos, Compre mais rápido com seus dados salvos, Lançamentos e ofertas em primeira mão",
      "label": "t:sections.main_account_auth.settings.perks.label",
      "info": "t:sections.main_account_auth.settings.perks.info"
    }
  ]
}
{% endschema %}
