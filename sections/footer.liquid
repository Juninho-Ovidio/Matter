{%- comment -%}
  ============================================================
  FOOTER — rodapé do site (Mater)
  ============================================================

  O QUE FAZ:
  Rodapé escuro em três faixas:
  1. Newsletter: chamada grande em Anton + campo de e-mail
     (form 'customer' nativo, tag "newsletter").
  2. Colunas: marca (logo, frase, redes), Navegação, Ajuda
     (políticas da loja + contato) e Atendimento (WhatsApp,
     e-mail, horário).
  3. Base: copyright, bandeiras de pagamento e o crédito
     "Desenvolvido por Jaciel Junior" (logo JJ → juninhodev.com).

  ONDE É USADA:
  sections/footer-group.json, em todas as páginas (layout/theme.liquid).

  PRINCIPAIS PARTES:
  - Logo: assets/logo-mater.png (preto) invertido para branco via
    CSS (filter: invert + mix-blend-mode: screen some com o fundo).
  - Navegação: menu do setting "menu" (Navegação → footer no admin).
    Sem menu, usa links padrão (Início, Coleções, Todos os
    produtos, Contato).
  - Ajuda: só as políticas cadastradas em Configurações → Políticas.
  - Contato: página com handle contato/contact, senão /pages/contato.
  - Redes: settings globais do tema (social_*_link).
  - Crédito do desenvolvedor: snippet 'logo-juninhodev'.
{%- endcomment -%}

{%- liquid
  assign contact_url = '/pages/contato'
  if pages['contato'].url != blank
    assign contact_url = pages['contato'].url
  elsif pages['contact'].url != blank
    assign contact_url = pages['contact'].url
  endif

  assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+'
  assign footer_email = section.settings.email | default: shop.email
  # Instagram: o setting do footer tem prioridade; senão, o das configurações do tema.
  assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link
-%}

<footer class="mfooter" data-section-id="{{ section.id }}">
  {%- comment -%}
    ---------------- 0. Faixa de imagem ----------------
    Foto das camisetas em largura total, que escurece embaixo até o
    preto do footer (sem emenda). Imagem do editor ou, sem ela, a arte
    empacotada assets/footer-camisetas-*.jpg (original em img/Camisasas.png).
  {%- endcomment -%}
  {%- if section.settings.show_banner -%}
    <div class="mfooter__banner">
      {%- if section.settings.banner_image != blank -%}
        {{
          section.settings.banner_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            class: 'mfooter__banner-img',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: section.settings.banner_heading | escape
        }}
      {%- else -%}
        <img
          class="mfooter__banner-img"
          src="{{ 'footer-camisetas-1200.jpg' | asset_url }}"
          srcset="
            {{ 'footer-camisetas-800.jpg' | asset_url }} 800w,
            {{ 'footer-camisetas-1200.jpg' | asset_url }} 1200w,
            {{ 'footer-camisetas-1600.jpg' | asset_url }} 1600w
          "
          sizes="100vw"
          width="1600"
          height="901"
          alt="Camisetas Mater: Teresa de Calcutá, Carlo Acutis, São Miguel Arcanjo e Pietrelcina"
          loading="lazy"
        >
      {%- endif -%}

      {%- if section.settings.banner_heading != blank or instagram_url != blank -%}
        <div class="mfooter__banner-content">
          <div>
            {%- if section.settings.banner_eyebrow != blank -%}
              <p class="mfooter__eyebrow">{{ section.settings.banner_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.banner_heading != blank -%}
              <p class="mfooter__banner-title">{{ section.settings.banner_heading | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
          {%- if instagram_url != blank -%}
            <a class="mfooter__banner-btn" href="{{ instagram_url }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'instagram' %}
              {{ section.settings.instagram_button_label | default: 'Siga no Instagram' | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} ---------------- 1. Newsletter ---------------- {%- endcomment -%}
  {%- if section.settings.show_newsletter -%}
    <div class="mfooter__news">
      <div class="mfooter__news-copy">
        <p class="mfooter__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p>
        <h2 class="mfooter__news-title">{{ section.settings.newsletter_heading | escape | newline_to_br }}</h2>
        {%- if section.settings.newsletter_text != blank -%}
          <p class="mfooter__news-text">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}
      </div>

      {%- form 'customer', class: 'mfooter__news-form', id: 'FooterNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="mfooter__news-ok" role="status">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Pronto! Você vai receber as novidades da Mater.
          </p>
        {%- else -%}
          <label class="visually-hidden" for="FooterNewsletterEmail">E-mail</label>
          <div class="mfooter__news-field">
            <input
              id="FooterNewsletterEmail"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="Seu melhor e-mail"
              autocomplete="email"
              autocapitalize="off"
              required
            >
            <button type="submit">
              Quero receber
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          {%- if form.errors -%}
            <small class="mfooter__news-error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
          <small class="mfooter__news-note">Sem spam. Cancele quando quiser.</small>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  {%- comment -%} ---------------- 2. Colunas ---------------- {%- endcomment -%}
  <div class="mfooter__cols">
    <div class="mfooter__brand">
      <a href="{{ routes.root_url }}" class="mfooter__logo-link" aria-label="{{ shop.name | escape }}">
        <img src="{{ 'logo-mater.png' | asset_url }}" class="mfooter__logo" width="800" height="332" alt="{{ shop.name | escape }}" loading="lazy">
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="mfooter__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- if instagram_url != blank or settings.social_facebook_link != blank or settings.social_linkedin_link != blank or wa_number != blank -%}
        <ul class="mfooter__social" role="list">
          {%- if instagram_url != blank -%}
            <li><a href="{{ instagram_url }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>
          {%- endif -%}
          {%- if wa_number != blank -%}
            <li>
              <a href="https://wa.me/{{ wa_number }}" aria-label="WhatsApp" rel="noopener" target="_blank">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.73 1.2h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm4.53 12c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.22-.73-.66-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_linkedin_link != blank -%}
            <li><a href="{{ settings.social_linkedin_link }}" aria-label="LinkedIn" rel="noopener" target="_blank">{% render 'icon', name: 'linkedin' %}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <nav class="mfooter__col" aria-label="Navegação">
      <h2 class="mfooter__heading">Navegação</h2>
      <ul role="list">
        {%- if section.settings.menu.links.size > 0 -%}
          {%- for link in section.settings.menu.links -%}
            <li><a href="{% render 'link-contato', link: link %}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.root_url }}">Início</a></li>
          <li><a href="{{ routes.collections_url }}">Coleções</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Todos os produtos</a></li>
          <li><a href="{{ contact_url }}">Contato</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <nav class="mfooter__col" aria-label="Ajuda">
      <h2 class="mfooter__heading">Ajuda</h2>
      <ul role="list">
        <li><a href="{{ contact_url }}">Fale conosco</a></li>
        {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}">Trocas e devoluções</a></li>{%- endif -%}
        {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Envio e entrega</a></li>{%- endif -%}
        {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacidade</a></li>{%- endif -%}
        {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Termos de uso</a></li>{%- endif -%}
        {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">Minha conta</a></li>{%- endif -%}
      </ul>
    </nav>

    <div class="mfooter__col">
      <h2 class="mfooter__heading">Atendimento</h2>
      <ul role="list" class="mfooter__contact">
        {%- if wa_number != blank -%}
          <li>
            <a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener">
              <span class="mfooter__contact-label">WhatsApp</span>
              {{ section.settings.whatsapp_display | default: wa_number | escape }}
            </a>
          </li>
        {%- endif -%}
        {%- if footer_email != blank -%}
          <li>
            <a href="mailto:{{ footer_email }}">
              <span class="mfooter__contact-label">E-mail</span>
              {{ footer_email | escape }}
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li>
            <span class="mfooter__contact-label">Horário</span>
            {{ section.settings.hours | escape }}
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  {%- comment -%} ---------------- 3. Base ---------------- {%- endcomment -%}
  <div class="mfooter__bottom">
    <p class="mfooter__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.</p>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="mfooter__payments" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'mfooter__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <a class="mfooter__dev" href="https://juninhodev.com/" target="_blank" rel="noopener">
      <span>Desenvolvido por</span>
      {% render 'logo-juninhodev', class: 'mfooter__dev-logo' %}
      <strong>Jaciel Junior</strong>
    </a>
  </div>
</footer>

<style>
  .mfooter {
    --mater-gutter: clamp(20px, 6vw, 100px);
    --footer-bg: var(--color-accent, #070707);
    --footer-fg: var(--color-accent-text, #fff);
    color: var(--footer-fg);
    background-color: var(--footer-bg);
  }
  .mfooter a { color: inherit; text-decoration: none; }

  /* 0. Faixa de imagem */
  .mfooter__banner {
    position: relative;
    aspect-ratio: 16 / 5;
    max-height: 440px;
    width: 100%;
    overflow: hidden;
  }
  .mfooter__banner-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    transform: scale(1.02);
    transition: transform 1.2s ease;
  }
  .mfooter__banner:hover .mfooter__banner-img { transform: scale(1.05); }
  /* Escurece embaixo até o preto do footer: a foto "entra" no rodapé sem emenda. */
  .mfooter__banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(7, 7, 7, 0) 40%, rgba(7, 7, 7, 0.55) 72%, var(--footer-bg) 100%);
    pointer-events: none;
  }
  /* Título à esquerda e botão do Instagram à direita, na mesma linha. */
  .mfooter__banner-content {
    position: absolute;
    z-index: 1;
    right: var(--mater-gutter);
    bottom: clamp(16px, 2.2vw, 30px);
    left: var(--mater-gutter);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .mfooter__banner-content .mfooter__eyebrow { margin-bottom: 6px; font-size: 11px; }
  .mfooter__banner-title {
    margin: 0;
    font-family: var(--font-display-family);
    font-size: clamp(1.3rem, 2.2vw, 2.1rem);
    line-height: 0.92;
    text-transform: uppercase;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }
  /* Botão do Instagram: preto com ícone e texto brancos, compacto. */
  .mfooter__banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px 7px 11px;
    font-family: var(--font-heading-family);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background-color: #070707;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .mfooter__banner-btn:hover { border-color: #fff; transform: translateY(-1px); }
  .mfooter__banner-btn svg { flex: none; width: 15px; height: 15px; color: #fff; transition: transform 0.2s ease; }
  .mfooter__banner-btn:hover svg { transform: rotate(-8deg) scale(1.1); }
  /* Com a faixa, a newsletter não precisa da borda de cima pesada. */
  .mfooter__banner + .mfooter__news { padding-top: clamp(16px, 2vw, 28px); }

  /* 1. Newsletter */
  .mfooter__news {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    padding: clamp(28px, 3.4vw, 48px) var(--mater-gutter) clamp(24px, 3vw, 40px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .mfooter__eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-heading-family);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .mfooter__news-title {
    margin: 0;
    font-family: var(--font-display-family);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.6vw, 2.6rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .mfooter__news-text { max-width: 30em; margin: 8px 0 0; font-size: 14px; line-height: 1.5; opacity: 0.7; }
  .mfooter__news-form { margin: 0; }
  .mfooter__news-field {
    display: flex;
    padding: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    transition: border-color 0.2s ease;
  }
  .mfooter__news-field:focus-within { border-color: var(--footer-fg); }
  .mfooter__news-field input {
    flex: 1;
    min-width: 0;
    padding: 0 18px;
    font-size: 16px;
    color: var(--footer-fg);
    background: none;
    border: none;
    outline: none;
  }
  .mfooter__news-field input::placeholder { color: var(--footer-fg); opacity: 0.5; }
  .mfooter__news-field button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 22px;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--footer-bg);
    background-color: var(--footer-fg);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .mfooter__news-field button:hover { opacity: 0.9; }
  .mfooter__news-field button:hover svg { transform: translateX(3px); }
  .mfooter__news-field button svg { transition: transform 0.15s ease; }
  .mfooter__news-note,
  .mfooter__news-error { display: block; margin: 10px 0 0 20px; font-size: 12px; opacity: 0.55; }
  .mfooter__news-error { color: #fca5a5; opacity: 1; }
  .mfooter__news-ok {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 16px 20px;
    font-size: 15px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
  }

  /* 2. Colunas */
  .mfooter__cols {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 44px);
    padding: clamp(26px, 3vw, 44px) var(--mater-gutter);
  }
  .mfooter__logo-link { display: inline-block; line-height: 0; }
  .mfooter__logo {
    display: block;
    width: clamp(110px, 9vw, 150px);
    height: auto;
    /* PNG preto → branco; o screen some com qualquer fundo claro do arquivo. */
    filter: invert(1);
    mix-blend-mode: screen;
  }
  .mfooter__tagline { max-width: 24em; margin: 12px 0 0; font-size: 13px; line-height: 1.5; opacity: 0.65; }
  .mfooter__social { display: flex; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .mfooter__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .mfooter__social a:hover { color: var(--footer-bg); background-color: var(--footer-fg); border-color: var(--footer-fg); }
  .mfooter__social svg { width: 17px; height: 17px; }

  .mfooter__heading {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .mfooter__col ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; font-size: 13px; }
  .mfooter__col a { opacity: 0.7; transition: opacity 0.15s ease; }
  .mfooter__col a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }
  .mfooter__contact li { display: grid; gap: 2px; line-height: 1.45; overflow-wrap: anywhere; }
  .mfooter__contact a { display: grid; gap: 2px; }
  .mfooter__contact-label {
    font-family: var(--font-heading-family);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .mfooter__contact li > :not(a) { opacity: 0.7; }

  /* 3. Base */
  .mfooter__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 14px var(--mater-gutter) calc(14px + env(safe-area-inset-bottom, 0px));
    font-size: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .mfooter__copy { margin: 0; opacity: 0.55; }
  .mfooter__payments { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .mfooter__payment-icon { display: block; width: 38px; height: 24px; }
  .mfooter__dev {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .mfooter__dev span { opacity: 0.6; }
  .mfooter__dev strong { font-weight: 600; letter-spacing: 0.02em; }
  .mfooter__dev-logo { width: 20px; height: auto; transition: transform 0.3s ease; }
  .mfooter__dev:hover { border-color: rgba(255, 255, 255, 0.5); background-color: rgba(255, 255, 255, 0.06); }
  .mfooter__dev:hover .mfooter__dev-logo { transform: rotate(-8deg) scale(1.1); }

  @media screen and (max-width: 999px) {
    .mfooter__banner { aspect-ratio: 16 / 9; }
    .mfooter__news { grid-template-columns: 1fr; align-items: start; }
    .mfooter__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mfooter__brand { grid-column: 1 / -1; }
  }
  @media screen and (max-width: 559px) {
    .mfooter__news-field { flex-direction: column; gap: 6px; padding: 6px; border-radius: 24px; }
    .mfooter__news-field input { min-height: 44px; }
    .mfooter__news-field button { justify-content: center; }
    .mfooter__cols { grid-template-columns: 1fr 1fr; gap: 22px 18px; }
    .mfooter__col:last-child { grid-column: 1 / -1; }
