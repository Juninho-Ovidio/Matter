{%- comment -%}
  ============================================================
  conta-senha — campo de senha com botão mostrar/ocultar
  ============================================================
  PARÂMETROS:
  - id: id do input (obrigatório, único na página)
  - name: atributo name (ex.: 'customer[password]')
  - label: rótulo visível
  - autocomplete: 'current-password' | 'new-password'
  - strength: true para mostrar o medidor de força
  - confirm: id do campo de senha a conferir (campo "confirmar senha")
  - invalid: true quando o Shopify devolveu erro nesse campo
{%- endcomment -%}

<label class="conta__field conta__field--full conta__field--password{% if invalid %} is-invalid{% endif %}" for="{{ id }}">
  <span>{{ label }}</span>
  <input
    type="password"
    id="{{ id }}"
    name="{{ name }}"
    autocomplete="{{ autocomplete | default: 'current-password' }}"
    {% if autocomplete == 'new-password' %}minlength="5"{% endif %}
    {% if confirm %}data-confirm="{{ confirm }}"{% endif %}
    placeholder="••••••••"
    required
    {% if invalid %}aria-invalid="true"{% endif %}
  >
  <button type="button" class="conta__eye" data-toggle-password aria-pressed="false" aria-label="Mostrar senha">
    <svg class="conta__eye-on" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/></svg>
    <svg class="conta__eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4M6.6 6.6C3.8 8.4 2 12 2 12s3.6 7 10 7c1.7 0 3.2-.5 4.4-1.2M9.9 9.9a3 3 0 0 0 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  </button>
</label>
{%- if strength -%}
  <div class="conta__strength conta__field--full" data-strength="{{ id }}" data-level="0" aria-live="polite">
    <span class="conta__strength-bar" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="conta__strength-label"></span>
  </div>
{%- endif -%}
