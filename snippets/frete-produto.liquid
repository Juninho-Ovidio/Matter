{%- comment -%}
  ============================================================
  frete-produto — calculadora de frete na página do produto
  ============================================================

  O QUE FAZ:
  Campo de CEP + botão "Calcular". Mostra as opções de frete reais da
  loja (as mesmas do checkout: Frenet → PAC, Sedex, Mini Envios, Jadlog;
  e entrega local, se houver) para a variante selecionada, qtd. 1.

  COMO FUNCIONA:
  - Storefront API da Shopify SEM token (acesso público permitido para
    carrinho): numa ÚNICA chamada cria um carrinho à parte só para cotar
    e pede as opções com @defer (as cotações da transportadora chegam num
    2º pedaço da resposta, multipart/mixed). O carrinho do cliente NÃO é
    tocado. A cotação precisa do CEP + UF; a UF sai da faixa do CEP
    (tabela dos Correios, sem rede).
  - Em paralelo, o ViaCEP (viacep.com.br) só confirma que o CEP existe e
    dá o nome da cidade para a legenda. Se ele falhar, as opções saem mesmo assim.
  - A API não devolve o prazo em dias; o prazo exato aparece no checkout.
    Cada opção ganha um rótulo (expressa, econômica, transportadora).

  VELOCIDADE (~2,5 s, quase tudo é a Frenet consultando os Correios):
  - Calcula sozinho ao completar os 8 números.
  - Resultado guardado na sessão (sessionStorage) por variante + CEP.
  - Com um CEP salvo de visita anterior, calcula em segundo plano quando o
    bloco aparece na tela: ao chegar nele, o resultado já está pronto.

  COMO USAR:
  {% render 'frete-produto', block: block, form_id: product_form_id %}
  Dentro do form do produto: o campo não tem name (não vai no POST) e o
  Enter é interceptado, para não adicionar ao carrinho sem querer.

  PARÂMETROS:
  - block: bloco "shipping_calculator" (settings heading, free_note).
  - form_id: id do form do produto (de onde sai a variante escolhida).
{%- endcomment -%}
<frete-produto
  class="frete"
  data-form-id="{{ form_id }}"
  data-api="/api/2026-07/graphql.json"
  {{ block.shopify_attributes }}
>
  <p class="frete__title">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/></svg>
    {{ block.settings.heading | default: 'Calcular frete' | escape }}
  </p>

  <div class="frete__row">
    <label class="visually-hidden" for="FreteCep-{{ block.id }}">CEP</label>
    <input
      id="FreteCep-{{ block.id }}"
      class="frete__input"
      type="text"
      inputmode="numeric"
      autocomplete="postal-code"
      placeholder="00000-000"
      maxlength="9"
      data-frete-cep
    >
    <button type="button" class="frete__btn" data-frete-calc>Calcular</button>
  </div>
  <a class="frete__help" href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" rel="noopener noreferrer">Não sei meu CEP</a>

  <div class="frete__result" data-frete-result aria-live="polite"></div>

  {%- if block.settings.free_note != blank -%}
    <p class="frete__note">{{ block.settings.free_note | escape }}</p>
  {%- endif -%}
</frete-produto>

<script>
  if (!customElements.get('frete-produto')) {
    // UF pela faixa do CEP (Correios): [maior prefixo de 5 dígitos, UF].
    var FRETE_UF = [
      [19999, 'SP'], [28999, 'RJ'], [29999, 'ES'], [39999, 'MG'], [48999, 'BA'], [49999, 'SE'],
      [56999, 'PE'], [57999, 'AL'], [58999, 'PB'], [59999, 'RN'], [63999, 'CE'], [64999, 'PI'],
      [65999, 'MA'], [68899, 'PA'], [68999, 'AP'], [69299, 'AM'], [69399, 'RR'], [69899, 'AM'],
      [69999, 'AC'], [72799, 'DF'], [72999, 'GO'], [73699, 'DF'], [76799, 'GO'], [76999, 'RO'],
      [77999, 'TO'], [78899, 'MT'], [79999, 'MS'], [87999, 'PR'], [89999, 'SC'], [99999, 'RS']
    ];

    customElements.define('frete-produto', class extends HTMLElement {
      connectedCallback() {
        this.input = this.querySelector('[data-frete-cep]');
        this.btn = this.querySelector('[data-frete-calc]');
        this.out = this.querySelector('[data-frete-result]');
        this.pending = {};

        // Lembra o último CEP digitado (conveniência; falha em silêncio).
        var saved = null;
        try { saved = localStorage.getItem('mater:cep'); if (saved) this.input.value = saved; } catch (e) {}

        this.input.addEventListener('input', () => {
          var d = this.input.value.replace(/\D/g, '').slice(0, 8);
          this.input.value = d.length > 5 ? d.slice(0, 5) + '-' + d.slice(5) : d;
          // CEP completo: já calcula, sem precisar clicar.
          if (d.length === 8) this.calc();
        });
        // Enter calcula em vez de enviar o form do produto (adicionar ao carrinho).
        this.input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); this.calc(); }
        });
        this.btn.addEventListener('click', () => this.calc());

        // CEP salvo: calcula quando o bloco chega perto da tela, para o
        // resultado já estar pronto quando o cliente olhar.
        if (saved && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            io.disconnect();
            this.calc();
          }, { rootMargin: '300px' });
          io.observe(this);
        }
      }

      variantId() {
        var form = document.getElementById(this.dataset.formId);
        var input = form && form.querySelector('input[name="id"]');
        return input ? input.value : null;
      }

      uf(cep) {
        var n = Number(cep.slice(0, 5));
        if (n < 1000) return null;
        for (var i = 0; i < FRETE_UF.length; i++) if (n <= FRETE_UF[i][0]) return FRETE_UF[i][1];
        return null;
      }

      message(text, isError) {
        var p = document.createElement('p');
        p.className = 'frete__msg' + (isError ? ' frete__msg--error' : '');
        p.textContent = text;
        this.out.replaceChildren(p);
      }

      label(option) {
        var t = (option.title || '').toLowerCase();
        if (option.deliveryMethodType === 'LOCAL') return 'Entrega local';
        if (option.deliveryMethodType === 'PICK_UP') return 'Retirada';
        // Palavras inteiras: "Jadlog Package" contém "pac" e não é PAC.
        if (/\bsedex\b/.test(t)) return 'Correios · entrega expressa';
        if (/\bmini envios?\b/.test(t)) return 'Correios · econômica';
        if (/\bpac\b/.test(t)) return 'Correios · entrega normal';
        return 'Transportadora';
      }

      money(amount) {
        return Number(amount).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      }

      // Cidade para a legenda e confirmação de que o CEP existe.
      // Rede fora do ar não bloqueia: devolve null e a cotação segue.
      city(cep) {
        return fetch('https://viacep.com.br/ws/' + cep + '/json/')
          .then(function (r) { return r.json(); })
          .then(function (a) { return a && a.erro ? { invalid: true } : { name: a.localidade + '/' + a.uf }; })
          .catch(function () { return null; });
      }

      // Uma chamada: cria o carrinho de cotação e, com @defer, recebe as opções.
      rates(cep, uf, variant) {
        return fetch(this.dataset.api, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'multipart/mixed; deferSpec=20220824, application/json' },
          body: JSON.stringify({
            query: 'mutation($i: CartInput!) { cartCreate(input: $i) { cart { id ... @defer { deliveryGroups(first: 5, withCarrierRates: true) { nodes { deliveryOptions { title estimatedCost { amount } deliveryMethodType } } } } } userErrors { message } } }',
            variables: { i: {
              lines: [{ merchandiseId: 'gid://shopify/ProductVariant/' + variant, quantity: 1 }],
              buyerIdentity: { countryCode: 'BR' },
              delivery: { addresses: [{ selected: true, address: { deliveryAddress: { zip: cep, countryCode: 'BR', provinceCode: uf } } }] }
            } }
          })
        })
          .then(function (r) { return r.text(); })
          .then(function (text) {
            // Resposta com @defer vem em partes separadas por "--graphql".
            var options = [];
            text.split('--graphql').forEach(function (part) {
              var json = part.slice(part.indexOf('{')).trim();
              if (json.charAt(0) !== '{') return;
              try { json = JSON.parse(json); } catch (e) { return; }
              (json.incremental || []).forEach(function (inc) {
                var groups = inc.data && inc.data.deliveryGroups;
                ((groups && groups.nodes) || []).forEach(function (g) {
                  (g.deliveryOptions || []).forEach(function (o) { options.push(o); });
                });
              });
            });
            return options.sort(function (a, b) { return Number(a.estimatedCost.amount) - Number(b.estimatedCost.amount); });
          });
      }

      async calc() {
        var cep = this.input.value.replace(/\D/g, '');
        if (cep.length !== 8) return this.message('Digite um CEP com 8 números.', true);
        var uf = this.uf(cep);
        if (!uf) return this.message('Não encontramos esse CEP. Confira os números.', true);
        var variant = this.variantId();
        if (!variant) return this.message('Escolha um tamanho para calcular o frete.', true);
        try { localStorage.setItem('mater:cep', this.input.value); } catch (e) {}

        var key = 'mater:frete:' + variant + ':' + cep;
        try {
          var hit = sessionStorage.getItem(key);
          if (hit) return this.render(JSON.parse(hit), cep);
        } catch (e) {}
        // Mesmo cálculo já em andamento (ex.: digitou e clicou): não repete.
        if (this.pending[key]) return;
        this.pending[key] = true;

        this.btn.disabled = true;
        this.btn.textContent = 'Calculando…';
        this.message('Consultando os Correios e transportadoras…');
        try {
          var both = await Promise.all([this.city(cep), this.rates(cep, uf, variant)]);
          var place = both[0];
          if (place && place.invalid) throw new Error('cep');
          var data = { options: both[1], city: place ? place.name : null };
          try { sessionStorage.setItem(key, JSON.stringify(data)); } catch (e) {}
          // Só mostra se o cliente não trocou o CEP enquanto calculava.
          if (this.input.value.replace(/\D/g, '') === cep) this.render(data, cep);
        } catch (e) {
          this.message(e.message === 'cep' ? 'Não encontramos esse CEP. Confira os números.' : 'Não foi possível calcular agora. Tente de novo em instantes.', true);
        } finally {
          delete this.pending[key];
          this.btn.disabled = false;
          this.btn.textContent = 'Calcular';
        }
      }

      render(data, cep) {
        if (!data.options.length) return this.message('Ainda não entregamos nesse CEP.', true);
        var list = document.createElement('ul');
        list.className = 'frete__list';
        list.setAttribute('role', 'list');
        data.options.forEach((o) => {
          var li = document.createElement('li');
          li.className = 'frete__option';
          var info = document.createElement('span');
          var name = document.createElement('strong');
          name.textContent = o.title;
          var kind = document.createElement('small');
          kind.textContent = this.label(o);
          info.append(name, kind);
          var price = document.createElement('span');
          price.className = 'frete__price';
          price.textContent = Number(o.estimatedCost.amount) === 0 ? 'Grátis' : this.money(o.estimatedCost.amount);
          li.append(info, price);
          list.append(li);
        });
        var where = document.createElement('p');
        where.className = 'frete__where';
        where.textContent = 'Para ' + (data.city || 'o CEP ' + cep.slice(0, 5) + '-' + cep.slice(5)) + ' · o prazo exato aparece no checkout.';
        this.out.replaceChildren(list, where);
      }
    });
  }
</script>

<style>
  .frete {
    display: block;
    margin: 0 0 22px;
    padding: 16px;
    background-color: var(--color-background-contrast);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .frete__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .frete__row { display: flex; gap: 8px; }
  .frete__input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 10px 14px;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--color-text);
    background-color: var(--color-background-contrast);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .frete__input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .frete__btn {
    flex: none;
    min-height: 44px;
    padding: 10px 18px;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .frete__btn:disabled { opacity: 0.6; cursor: progress; }
  .frete__help {
    display: inline-block;
    margin-top: 8px;
    font-size: 12px;
    color: inherit;
    text-decoration: underline;
    opacity: 0.7;
  }
  .frete__result:empty { display: none; }
  .frete__result { margin-top: 12px; }
  .frete__list { margin: 0; padding: 0; list-style: none; }
  .frete__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--color-border);
  }
  .frete__option:first-child { border-top: 0; padding-top: 0; }
  .frete__option strong { display: block; font-size: 14px; }
  .frete__option small { display: block; margin-top: 2px; font-size: 12px; opacity: 0.6; }
  .frete__price { flex: none; font-size: 14px; font-weight: 700; }
  .frete__where, .frete__msg { margin: 10px 0 0; font-size: 12px; opacity: 0.7; }
  .frete__msg { margin: 0; opacity: 1; }
  .frete__msg--error { color: var(--color-sale, #b91c1c); }
  .frete__note {
    margin: 12px 0 0;
    padding-top: 10px;
    font-size: 12px;
    font-weight: 600;
    border-top: 1px dashed var(--color-border);
  }
</style>
