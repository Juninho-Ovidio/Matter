{%- comment -%}
  ============================================================
  meta-tags — meta tags de SEO e compartilhamento social
  ============================================================

  O QUE FAZ:
  Renderiza as meta tags de Open Graph e Twitter Cards (título, descrição,
  imagem, url e tipo da página). Em página de produto adiciona preço/moeda.
  No fim, injeta o structured-data correto conforme o tipo da página.

  COMO USAR:
  {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}
  Renderize dentro do <head>; o layout (theme.liquid) monta os dois textos.

  PARÂMETROS:
  - seo_title: título da página (o mesmo do <title>, sem o nome da marca).
  - seo_description: descrição (a da página ou a padrão das settings).

  OBSERVAÇÕES:
  Imagem de compartilhamento, em ordem: a da página (produto, coleção,
  artigo) > settings.share_image > a 1ª arte do hero empacotada no tema.
  Assim WhatsApp/Instagram/Facebook sempre mostram uma prévia. Tudo em
  https (http gera aviso de conteúdo misto em alguns apps).
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign og_title = seo_title | default: brand
  if request.page_type == 'index'
    assign og_title = brand
  endif
-%}
<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ seo_description | escape }}">
<meta property="og:locale" content="pt_BR">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- assign share_url = page_image | image_url: width: 1200 | prepend: 'https:' -%}
{%- elsif settings.share_image -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  {%- assign share_url = settings.share_image | image_url: width: 1200 | prepend: 'https:' -%}
{%- else -%}
  {%- assign share_url = 'hero-inicio-1920.jpg' | asset_url | prepend: 'https:' -%}
  <meta property="og:image" content="{{ share_url }}">
  <meta property="og:image:secure_url" content="{{ share_url }}">
  <meta property="og:image:width" content="1920">
  <meta property="og:image:height" content="966">
{%- endif -%}
<meta property="og:image:alt" content="{{ og_title | escape }}">

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
<meta name="twitter:image" content="{{ share_url }}">

{%- if request.page_type == 'product' -%}
  {% render 'structured-data-product' %}
{%- elsif request.page_type == 'index' -%}
  {% render 'structured-data-website' %}
{%- endif -%}
