{%- comment -%}
  ============================================================
  structured-data-website — JSON-LD de WebSite + Organization
  ============================================================

  O QUE FAZ:
  Gera dois blocos JSON-LD (schema.org) para a home: WebSite (com
  SearchAction para a caixa de busca do Google) e Organization (nome,
  url, logo e perfis sociais da marca).

  COMO USAR:
  {% render 'structured-data-website' %}
  Normalmente chamado por meta-tags apenas na home (page_type 'index').

  PARÂMETROS:
  Nenhum — usa shop, routes e as settings brand_name, logo e
  social_instagram_link (com fallback para o Instagram da marca).

  OBSERVAÇÕES:
  O placeholder {search_term_string} é montado por partes (append) de
  propósito, pra que as chaves literais não sejam interpretadas como
  tags Liquid. Não mexa nesse assign.
{%- endcomment -%}
{%- liquid
  assign search_placeholder = '?q=' | append: '{' | append: 'search_term_string' | append: '}'
  assign search_target = shop.url | append: routes.search_url | append: search_placeholder
  assign brand = settings.brand_name | default: shop.name
  assign instagram = settings.social_instagram_link | default: 'https://www.instagram.com/matercatholicstore/'
  if settings.logo
    assign org_logo = settings.logo | image_url: width: 500 | prepend: 'https:'
  else
    assign org_logo = 'logo-mater.png' | asset_url | prepend: 'https:'
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ brand | json }},
    "url": {{ shop.url | append: routes.root_url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ brand | json }},
    "url": {{ shop.url | append: routes.root_url | json }},
    "logo": {{ org_logo | json }},
    "sameAs": [{{ instagram | json }}]
  }
</script>
