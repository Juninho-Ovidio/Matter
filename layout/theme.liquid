{%- comment -%}
  ============================================================
  theme.liquid — Moldura (layout) de todas as paginas do tema
  ============================================================

  O QUE FAZ:
  Este e o layout padrao que envolve TODA pagina da loja (home,
  produto, colecao, carrinho, etc.). Define a estrutura HTML base.

  NO <head> temos:
  - Meta tags basicas, viewport e theme-color.
  - SEO: <title> dinamico (com tags/pagina/nome da loja),
    meta description, URL canonica.
  - Favicon e apple-touch-icon (config settings.favicon).
  - Open Graph / JSON-LD e demais tags via {% render 'meta-tags' %}.
  - CSS: fontes.css, normalizar.css e base.css (nessa ordem, cada um
    com asset_url versionado) + css-variables (variaveis do tema
    geradas pelas settings).
  - Scripts: troca no-js -> js e carrega carrinho.js (defer).
  - {{ content_for_header }}: scripts obrigatorios do Shopify.

  NO <body> temos:
  - Skip link de acessibilidade e snippets globais (alerta, carrinho).
  - Section groups do topo (header-group) e rodape (footer-group),
    editaveis pelo lojista no editor de temas.
  - {{ content_for_layout }}: aqui entra o conteudo especifico de
    cada template/pagina, dentro do <main id="MainContent">.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      Ícone da aba: o enviado em Configurações do tema > Logo > Favicon;
      sem ele, o "M" da marca empacotado em assets/favicon-*.png.
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ 'favicon-512.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon-180.png' | asset_url }}">
    {%- endif -%}

    {%- liquid
      # Nome da marca na aba e nas buscas (settings > SEO e marca).
      assign brand = settings.brand_name | default: shop.name
      assign seo_title = page_title
      # A coleção automática "all" vem da Shopify como "Products".
      if request.page_type == 'collection' and collection.handle == 'all'
        assign seo_title = 'sections.main_collection.all_title' | t
      endif
      # A busca vem como "Search: N results found for ..." (idioma base da loja).
      if request.page_type == 'search'
        if search.performed
          assign seo_title = 'templates.search.search_for' | t: terms: search.terms
        else
          assign seo_title = 'templates.search.title' | t
        endif
      endif
      assign seo_description = page_description | default: settings.seo_description | default: shop.description
    -%}
    <title>
      {%- if request.page_type == 'index' -%}
        {{ brand }}
      {%- else -%}
        {{ seo_title }}
        {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
        {%- unless seo_title contains brand %} &ndash; {{ brand }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | strip_html | strip | escape }}">
    {%- endif -%}

    {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}

    {%- comment -%}
      Cada CSS entra direto, com asset_url (?v=versão). Antes era um
      index.css com @import sem versão — o CDN/navegador podia servir
      uma cópia antiga de base.css por até 1 ano e a página ficava sem estilo.
    {%- endcomment -%}
    {%- comment -%}
      Anton (títulos) é pré-carregada: sem isso o navegador só a descobre
      depois de ler o CSS, e o título aparece primeiro na fonte reserva.
    {%- endcomment -%}
    {{ 'anton-regular-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'fontes.css' | asset_url | stylesheet_tag }}
    {{ 'normalizar.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'carrinho.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'favoritos.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'card-variantes.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% render 'alerta' %}
    {% render 'carrinho' %}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
